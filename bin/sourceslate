#!/usr/bin/env php
<?php

declare(strict_types=1);

use SourceSlate\Application;
use Symfony\Component\Console\Input\ArgvInput;

require dirname(__DIR__) . '/vendor/autoload.php';

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'] ?? [];
$firstArgument = $arguments[1] ?? null;
$commands = [
    'build',
    'list',
    'help',
    'completion',
    'cache:list',
    'cache:info',
    'cache:verify',
    'cache:repair',
    'cache:prune',
    'cache:clear',
];

if (
    $firstArgument !== null
    && $firstArgument !== ''
    && !str_starts_with($firstArgument, '-')
    && !in_array($firstArgument, $commands, true)
) {
    array_splice($arguments, 1, 0, ['build']);
}

exit((new Application())->run(new ArgvInput($arguments)));
