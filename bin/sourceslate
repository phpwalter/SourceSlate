#!/usr/bin/env php
<?php

declare(strict_types=1);

use SourceSlate\Application;
use Symfony\Component\Console\Input\ArgvInput;

$autoload = isset($_composer_autoload_path) && is_string($_composer_autoload_path)
    ? $_composer_autoload_path
    : dirname(__DIR__) . '/vendor/autoload.php';

require $autoload;

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'] ?? [];
$firstArgument = $arguments[1] ?? null;
$commands = [
    'build',
    'doctor',
    'config:show',
    'list',
    'help',
    'completion',
    'cache:list',
    'cache:info',
    'cache:verify',
    'cache:repair',
    'cache:prune',
    'cache:clean',
    'cache:clear',
];

if (
    $firstArgument !== null
    && $firstArgument !== ''
    && !str_starts_with($firstArgument, '-')
    && !in_array($firstArgument, $commands, true)
) {
    array_splice($arguments, 1, 0, ['build']);
}

exit((new Application())->run(new ArgvInput($arguments)));
