{
  "name": "phpwalter/sourceslate",
  "description": "A modern static documentation generator for PHP source code and PHPDoc.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "nikic/php-parser": "^5.1",
    "phpstan/phpdoc-parser": "^2.0",
    "symfony/console": "^7.1",
    "symfony/yaml": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SourceSlate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SourceSlate\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/sourceslate"
  ],
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
