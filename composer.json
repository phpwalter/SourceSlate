{
  "name": "phpwalter/sourceslate",
  "description": "A deterministic static documentation generator for PHP source code and PHPDoc.",
  "type": "library",
  "license": "proprietary",
  "keywords": [
    "documentation",
    "phpdoc",
    "static-analysis",
    "api-documentation",
    "developer-tools"
  ],
  "homepage": "https://github.com/phpwalter/SourceSlate",
  "support": {
    "issues": "https://github.com/phpwalter/SourceSlate/issues",
    "source": "https://github.com/phpwalter/SourceSlate"
  },
  "require": {
    "php": "^8.3",
    "nikic/php-parser": "^5.1",
    "phpstan/phpdoc-parser": "^2.0",
    "symfony/console": "^7.1",
    "symfony/yaml": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SourceSlate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SourceSlate\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/sourceslate"
  ],
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint_php.php",
    "release-audit": "php tools/release_audit.php",
    "validate-project": "composer validate --strict",
    "check": [
      "@validate-project",
      "@lint",
      "@test",
      "@release-audit"
    ]
  },
  "archive": {
    "exclude": [
      "/.github",
      "/tests",
      "/docs",
      "/.gitignore"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
